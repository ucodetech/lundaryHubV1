APP_NAME="LaundryHub Platform"
APP_ENV=local
APP_KEY=base64:CaZkHbKgruA55hBJVC7gC7dKUt6GM1B1zLamjVecl+U=
APP_DEBUG=true
APP_TIMEZONE=Africa/Lagos
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laundryhub
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=reverb
FILESYSTEM_DISK=public
QUEUE_CONNECTION=sync
CACHE_STORE=database

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log

# Laravel Reverb WebSockets
REVERB_APP_ID=laundryhub
REVERB_APP_KEY=laundryhub-key
REVERB_APP_SECRET=laundryhub-secret
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# Paystack Payment Gateway
PAYSTACK_PUBLIC_KEY=pk_test_sample
PAYSTACK_SECRET_KEY=sk_test_sample
PAYSTACK_MERCHANT_EMAIL=admin@laundryhub.ng

# Termii SMS OTP Provider
TERMII_API_KEY=sample_termii_key
TERMII_SENDER_ID=LaundryHub

# Google Maps API Key
VITE_GOOGLE_MAPS_API_KEY=sample_google_maps_key

# Cloudinary Storage Config
CLOUDINARY_URL=cloudinary://sample_key:sample_secret@cloud_name
